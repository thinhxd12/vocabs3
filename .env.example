# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# Neon Auth (Project -> Branch -> Auth -> Configuration)
NEON_AUTH_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET="replace-with-32-plus-random-characters"
# The only account allowed to sign in with a password
LOGIN_EMAIL="user@example.com"
